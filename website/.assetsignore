# Beehive Strategy Pages deploy exclusions (gitignore syntax)
# Purpose: keep internal tooling, drafts and backup files out of public deploys.
# Verification files (BingSiteAuth.xml, b5e7a3f1*.txt, indexnow key) are NOT excluded.

# internal pipeline & tooling
_batch_pipeline/
_chrome/
templates/
seo-audit-report/
seo-audit-summary/
beehive-homepage/
beehive-homepage-draft/
node_modules/
.git/

# backup / temp files
*.bak
*.bak-*
*.tmp
*.zip
.DS_Store

# top-level drafts & internal notes (source .md, audit output)
/*.md
/audit_*.txt
bing_wm_login_options.png
