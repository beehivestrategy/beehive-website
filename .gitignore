# Exclude everything except the website directory
# This keeps the repo clean for Vercel deployment

/*

# Include the website directory
!website/

# Include Vercel config at root (required for deployment)
!vercel.json

# Include generation scripts at root
!generate_zh_tw.py
!generate_multilang.py

# Include GitHub Actions workflows at root
!.github/

# Include this .gitignore
!.gitignore

# Still exclude any workbuddy data inside website
website/.workbuddy/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/
.idea/
*.swp
*.swo

# Python
__pycache__/
*.pyc

# Logs
*.log
.vercel
.env*
